---
interface Props { story?: boolean; }
const { story = false } = Astro.props;
const nodes = Array.from({length: 95}, (_, i) => { const a = i * 2.39996; const r = 185 * Math.sqrt(i / 94); return {x: 260 + Math.cos(a) * r, y: 240 + Math.sin(a) * r * .86}; });
---
<div class:list={['network', { 'story-network': story }]} data-network data-story={story}>
  <div class="network-stage" aria-hidden="true">
    <svg class="network-fallback" viewBox="0 0 520 480"><g stroke="currentColor" stroke-width=".65" opacity=".23">{nodes.map((n,i) => nodes.slice(i+1).filter(m => Math.hypot(n.x-m.x,n.y-m.y)<66).map(m => <line x1={n.x} y1={n.y} x2={m.x} y2={m.y}/>))}</g>{nodes.map(n=><circle cx={n.x} cy={n.y} r="2" fill="currentColor"/>)}</svg>
  </div>
  <span class="network-label label-a">{story ? 'EVIDENCE' : 'REPRESENTATION'}</span><span class="network-label label-b">{story ? 'DECISION' : 'REASONING'}</span><span class="network-label label-c">{story ? 'CONSEQUENCE' : 'ACTION'}</span>
  <div class="network-bottom"><span class="eyebrow">{story ? 'A question taking shape' : 'Relations become possibilities'}</span><button class="motion-button" type="button" aria-label="Pause network animation" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span></button></div>
</div>
<script>
  // Keep the illustrated fallback visible while the optional WebGL module loads.
  const load = () => import('../scripts/network').then(({ initNetworks }) => initNetworks()).catch(() => {});
  if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 1500 });
  else setTimeout(load, 150);
</script>
