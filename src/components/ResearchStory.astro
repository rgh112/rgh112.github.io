---
import { story } from '../data/story';
import ResearchScene from './ResearchScene.astro';
import StoryMorph from './StoryMorph.astro';
---
<section id="thread" class="research-story wrap" aria-labelledby="story-title">
  <div class="story-sticky">
    <span class="eyebrow" id="story-title">How the research connects</span>
    <div class="story-display" aria-label="Illustration for the current research question">
      <StoryMorph />
      <nav class="story-steps" aria-label="Research stages">{story.map((s,i)=><a href={`#research-step-${i}`} data-step={i} aria-current={i===0?'step':undefined}><span>{s.n}</span>{s.label}</a>)}</nav>
    </div>
    <p class="story-figure-note">Conceptual illustrations of the research questions.</p>
  </div>
  <div class="story-chapters">{story.map((s,i)=><article class:list={['story-chapter',{'chapter-active':i===0}]} id={`research-step-${i}`} data-chapter={i}>
    <div class="chapter-copy">
    <span class="chapter-number">{s.n} <span>/ {s.label}</span></span><h2>{s.title}</h2><p>{s.text}</p><a class="inline-link" href={s.link}>{s.cta} <span aria-hidden="true">↗</span></a>
    <div class="chapter-figure"><ResearchScene stage={i}/></div>
    </div>
  </article>)}</div>
</section>
<script>
  import { initStoryMorph } from '../scripts/story-morph';
  const root = document.querySelector<HTMLElement>('#thread');
  if(root) initStoryMorph(root);
</script>
<style is:global>
  .research-story .story-sticky { display: none; }
  .research-story { grid-template-columns: 1fr; }
  .story-chapter { scroll-margin-top: 120px; }
  .chapter-figure { margin-top: 28px; max-width: 620px; }
  .research-scene { color: #30372e; background: #f7f8f5; border: 1px solid #dfe3d9; }
  .scene-heading { display: flex; align-items: baseline; gap: 16px; padding: 24px 23px 0; }
  .scene-number { font-size: 11px; font-weight: 650; color: #62685a; }
  .scene-heading h3 { font-size: 17px; line-height: 1.45; letter-spacing: -.025em; font-weight: 600; }
  .scene-svg { display: block; width: 100%; height: auto; padding: 0 8px; }
  .scene-svg path { stroke-linecap: round; stroke-linejoin: round; }
  .scene-paper { fill: white; stroke: currentColor; stroke-width: 1.8; }
  .scene-line { stroke: currentColor; stroke-width: 1.8; }
  .scene-flow { stroke: currentColor; stroke-width: 2.8; }
  .scene-muted { stroke: #8a9380; stroke-width: 1.5; }
  .scene-return { stroke: #748269; stroke-width: 1.5; stroke-dasharray: 4 5; }
  .scene-grid { stroke: #dce1d6; stroke-width: 1; }
  .scene-dot { fill: currentColor; }
  .scene-label { fill: currentColor; font-family: var(--sans); font-size: 14px; font-weight: 550; }
  .scene-small { fill: #58634f; font-family: var(--sans); font-size: 12px; font-weight: 450; }
  .scene-state { fill: currentColor; font-family: var(--sans); font-size: 18px; font-weight: 550; }
  .scene-tile { fill: #fff; stroke: #859079; stroke-width: 1; }
  .tile-filled { fill: #cad3bf; }
  .scene-prediction path { stroke-dasharray: 5 6; }
  .research-scene figcaption { padding: 18px 23px 22px; border-top: 1px solid #dfe3d9; }
  .research-scene figcaption p { font-size: 13px; line-height: 1.7; min-height: 3.4em; margin: 0; color: #3b4533; }
  .research-scene figcaption span { display: block; font-size: 10px; line-height: 1.7; color: #5b6253; margin-top: 12px; }
  .story-steps { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 18px; gap: 12px; }
  .story-steps a { font-size: 10px; font-weight: 500; border-top: 2px solid #d9ded2; padding-top: 10px; color: #616b56; }
  .story-steps span { display: block; font-size: 11px; margin-bottom: 3px; }
  .story-steps a[aria-current] { border-color: #30372e; color: #20281b; font-weight: 650; }
  .story-figure-note { font-size: 10px; margin-top: 23px; color: #656c5d; }
  .story-enhanced .story-sticky { display: block; position: sticky; top: 0; z-index: 3; background: #fff; padding: 16px 0; }
  .story-enhanced .chapter-figure { display: none; }
  .story-enhanced .story-chapter { min-height: 150svh; }
  .story-enhanced .story-chapter:last-child { min-height: 100svh; }
  .story-display { margin-top: 16px; }
  .story-morph { padding-top: 6px; color: #30372e; }
  .morph-heading { display: flex; align-items: baseline; gap: 14px; min-height: 51px; }
  .morph-heading > span { color: #686e61; font-size: 11px; font-weight: 600; }
  .morph-heading h3 { font-size: 17px; font-weight: 580; line-height: 1.4; letter-spacing: -.02em; }
  .morph-svg { display: block; width: 100%; height: auto; aspect-ratio: 600 / 490; max-height: calc(100svh - 320px); overflow: visible; }
  .morph-svg path { stroke-linecap: round; stroke-linejoin: round; }
  .morph-sources { stroke: #bac1b1; stroke-width: 1.1; }
  .morph-sources path { stroke: #88937c; }
  [data-morph-halos] { stroke: #ccd4c3; stroke-width: 1; stroke-dasharray: 3 5; }
  .morph-edges { stroke: #364130; }
  .morph-nodes circle { fill: #394333; stroke: #fff; stroke-width: 1.5; }
  .morph-nodes .morph-hub { fill: white; stroke: #394333; stroke-width: 2; }
  .morph-goal { stroke: #394333; stroke-width: 1.5; }
  [data-morph-stop] { stroke: #394333; stroke-width: 1.7; }
  .morph-labels { font-family: var(--sans); font-size: 13px; fill: #505c46; font-weight: 500; }
  .morph-forecast-key { font-family: var(--sans); font-size: 11px; fill: #59654e; }
  .morph-forecast-key path { stroke: #59654e; stroke-width: 1.5; stroke-dasharray: 5 5; }
  .story-morph figcaption { padding: 19px 0 0; border-top: 1px solid var(--line); }
  .story-morph figcaption p { min-height: 3.4em; font-size: 13px; line-height: 1.7; }
  .story-morph figcaption > span { display: block; font-size: 10px; color: #606854; margin-top: 10px; }
  .story-steps a { position: relative; }
  .story-steps a:before { content: ''; position: absolute; top: -2px; left: 0; right: 0; height: 2px; background: #30372e; transform: scaleX(var(--step-progress, 0)); transform-origin: left; }
  .story-steps a[aria-current] { border-color: #d9ded2; }
  @media(min-width:1001px) {
    .story-enhanced { grid-template-columns: 1fr 1fr; gap: 10%; }
    .story-enhanced .story-sticky { top: 20px; padding-top: 24px; }
    .story-display { margin-top: 24px; }
    /* Scroll distance sets the pace; the graphic still tracks scrolling directly. */
    .story-enhanced .story-chapter { min-height: max(960px, 180svh); }
    .story-enhanced .chapter-copy { position: sticky; top: 32svh; }
  }
  @media(max-width:1000px) {
    .story-enhanced .story-sticky { align-self: start; border-bottom: 1px solid var(--line); }
    .story-sticky > .eyebrow { font-size: 9px; }
    .story-display { margin-top: 8px; }
    .morph-heading { min-height: 30px; gap: 10px; }
    .morph-heading h3 { font-size: 13px; }
    .morph-svg { height: clamp(170px, 28svh, 265px); max-height: none; }
    .story-morph figcaption, .story-figure-note { display: none; }
    .story-steps { margin-top: 8px; gap: 10px; }
    .story-steps a { font-size: 9px; padding-top: 6px; }
    .story-steps span { display: inline; font-size: 9px; margin-right: 5px; }
    .story-enhanced .story-chapter { padding-top: 35px; }
  }
  @media(max-width:760px) {
    .scene-heading { padding: 20px 18px 0; gap: 12px; }
    .scene-heading h3 { font-size: 16px; }
    .scene-svg { padding: 0; }
    .scene-label { font-size: 15px; }
    .scene-small { font-size: 13px; }
    .research-scene figcaption { padding: 16px 18px 18px; }
    .research-scene figcaption p { font-size: 12px; min-height: 0; }
    .research-scene figcaption span { font-size: 10px; }
    .story-chapter { scroll-margin-top: 30px; }
  }
</style>
