---
import Layout from '../layouts/Layout.astro';
import WordLadder from '../components/WordLadder.astro';
import PaperCard from '../components/PaperCard.astro';
import ResearchStory from '../components/ResearchStory.astro';
import { papers } from '../data/papers';
import { profile } from '../data/profile';

---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Kunhee Ryu</h1>
      <p class="hero-intro">I’m interested in how AI represents its environment and anticipates the consequences of its actions.</p>
      <a href="/research/" class="text-link">View research <span aria-hidden="true">↗</span></a>
    </div>
    <WordLadder />
    <div class="hero-foot"><a href="#thread">Research overview <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="intro-strip wrap" data-reveal><span class="eyebrow">Research overview</span><p>How do agents use evidence<br />to choose their <em>next action?</em></p><span class="intro-aside">Evidence extraction, verification,<br />and sequential decisions.</span></section>

  <ResearchStory />

  <section class="selected-work wrap" aria-labelledby="selected-title">
    <div class="section-heading"><div><span class="eyebrow">Publications</span><h2 id="selected-title">Selected <em>research.</em></h2></div><a class="text-link" href="/research/">All research <span aria-hidden="true">↗</span></a></div>
    <div class="paper-grid">{papers.slice(0,4).map((paper,index)=><PaperCard paper={paper} index={index}/>)}</div>
  </section>

  <section class="about-strip wrap"><span class="eyebrow">About</span><p>I work at the <a href={profile.links.lab} target="_blank" rel="noopener noreferrer">Human Artificial Intelligence Research Lab ↗</a> at Yonsei University, with Professor Keeheon Lee. I joined the lab in 2021.</p><a href="/about/" class="text-link">More about me <span aria-hidden="true">↗</span></a></section>
</Layout>
