---
import Layout from '../layouts/Layout.astro';
import PaperCard from '../components/PaperCard.astro';
import ResearchStory from '../components/ResearchStory.astro';
import Authors from '../components/Authors.astro';
import { papers } from '../data/papers';
import { profile } from '../data/profile';
const selectedSlugs=['beyond-local-validity','ood-resolution','autometa','partner-choice'];
const selectedPapers=selectedSlugs.map(slug=>papers.find(p=>p.slug===slug)!);
const socialPapers=papers.filter(p=>p.category==='Social simulation');
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Kunhee Ryu</h1>
      <p class="hero-intro">I’m interested in how AI represents its environment and anticipates the consequences of its actions. I also study how agents choose collaborators and coordinate in social simulations.</p>
      <a href="/research/" class="text-link">View research <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-foot"><a href="#thread">Research overview <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="intro-strip wrap" data-reveal><span class="eyebrow">Research overview</span><p>How do agents use evidence<br />to choose their <em>next action?</em></p><span class="intro-aside">Evidence extraction, verification,<br />and sequential decisions.</span></section>

  <ResearchStory />

  <section class="social-research wrap" aria-labelledby="social-title">
    <div><span class="eyebrow">Research area</span><h2 id="social-title">Social simulation</h2><p>I use agent-based simulations to study how agents choose collaborators, share information, and coordinate over repeated interactions. These settings let me vary memory, group composition, and shared rules, then examine what changes in their behavior.</p><a class="inline-link" href="/directions/#social">Related research interests ↗</a></div>
    <ul>{socialPapers.map(p=><li><a href={`/research/${p.slug}/`}>{p.short} <span aria-hidden="true">↗</span></a><span class="social-authors"><Authors authors={p.authors}/></span><span>{p.venue}{p.status==='Accepted' && ' · Accepted'}{p.presentation && ` · ${p.presentation}`}</span></li>)}</ul>
  </section>

  <section class="selected-work wrap" aria-labelledby="selected-title">
    <div class="section-heading"><div><span class="eyebrow">Publications</span><h2 id="selected-title">Selected <em>research.</em></h2></div><a class="text-link" href="/research/">All research <span aria-hidden="true">↗</span></a></div>
    <div class="paper-grid">{selectedPapers.map((paper,index)=><PaperCard paper={paper} index={index}/>)}</div>
  </section>

  <section class="about-strip wrap"><span class="eyebrow">About</span><p>I work at the <a href={profile.links.lab} target="_blank" rel="noopener noreferrer">Human Artificial Intelligence Research Lab ↗</a> at Yonsei University, with Professor Keeheon Lee. I joined the lab in 2021.</p><a href="/about/" class="text-link">More about me <span aria-hidden="true">↗</span></a></section>
</Layout>
