---
import Layout from '../layouts/Layout.astro';
import Network from '../components/Network.astro';
import PaperCard from '../components/PaperCard.astro';
import ResearchStory from '../components/ResearchStory.astro';
import { papers } from '../data/papers';
import { profile } from '../data/profile';

---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="eyebrow hero-eyebrow"><span class="live-dot"></span> Researcher · Yonsei University</div>
      <h1>Learning to reason.<br />Learning to <em>act.</em></h1>
      <p class="hero-intro">I’m Kunhee. I study how AI can understand relationships, reason with evidence, and anticipate the consequences of its actions.</p>
      <a href="/research/" class="text-link">Explore my research <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-art"><Network /></div>
    <div class="hero-foot"><span>Representation → Reasoning → Action</span><a href="#thread">Follow the questions <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="intro-strip wrap" data-reveal><span class="eyebrow">The thread through my work</span><p>What must an AI understand<br />to make its <em>next move?</em></p><span class="intro-aside">From scientific evidence<br />to decisions that unfold over time.</span></section>

  <ResearchStory />

  <section class="selected-work wrap" aria-labelledby="selected-title">
    <div class="section-heading"><div><span class="eyebrow">Questions, made concrete</span><h2 id="selected-title">Selected <em>research.</em></h2></div><a class="text-link" href="/research/">All research <span aria-hidden="true">↗</span></a></div>
    <div class="paper-grid">{papers.slice(0,4).map((paper,index)=><PaperCard paper={paper} index={index}/>)}</div>
  </section>

  <section class="personal-note wrap" data-reveal><span class="eyebrow">Where a question begins</span><div><h2>Sometimes, it starts<br />with a <em>wuxia novel.</em></h2><p>In wuxia novels, accumulated inner power may not be enough to break through to the next realm: a crucial insight can still be missing. That barrier made me think about grokking—and the progress a model might make before generalization becomes visible.</p><a class="text-link" href="/research/ood-resolution/#origin">The story behind the research <span aria-hidden="true">↗</span></a></div><div class="wuxia-mark" aria-hidden="true"><span>Inner power</span><i>+</i><span>Insight</span><i class="wuxia-arrow">→</i><span>Breakthrough</span></div></section>

  <section class="about-strip wrap"><span class="eyebrow">A little context</span><p>I work at the <a href={profile.links.lab} target="_blank" rel="noopener noreferrer">Human Artificial Intelligence Research Lab ↗</a> at Yonsei University, with Professor Keeheon Lee. My research brings together machine learning, agent systems, and the people who use them.</p><a href="/about/" class="text-link">More about me <span aria-hidden="true">↗</span></a></section>
</Layout>
