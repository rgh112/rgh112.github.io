---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { papers } from '../data/papers';
import Authors from '../components/Authors.astro';
---
<Layout title="Curriculum vitae" description="Kunhee Ryu’s curriculum vitae: education, research, publications, teaching, and academic service.">
  <article class="cv wrap">
    <header class="cv-head"><div><span class="eyebrow">Curriculum vitae</span><h1>Kunhee Ryu</h1><p>Researcher · Human Artificial Intelligence Research Lab<br />Yonsei University · Seoul, Republic of Korea</p><a href={`mailto:${profile.email}`}>{profile.email}</a><div class="cv-socials"><a href={profile.links.scholar}>Google Scholar ↗</a><a href={profile.links.orcid}>ORCID ↗</a><a href={profile.links.github}>GitHub ↗</a></div></div><div class="cv-actions"><a class="button button-dark" href="/Kunhee_Ryu_CV.pdf" download>Download CV <span aria-hidden="true">↓</span></a><button class="button" id="print-cv">Print CV ↗</button><span class="eyebrow" data-cv-updated={profile.updated}>Updated {profile.updated}</span></div></header>
    <section class="cv-section"><h2>Education</h2><div><div class="cv-entry"><div><h3>Yonsei University</h3><p>M.S. in Innovation</p><p class="muted">Advisor: Professor Keeheon Lee</p><p class="cv-small">Thesis: Enhancing Document Retrieval-Augmented Generation through Knowledge Graph Integration for Biomedical Question Answering</p></div><span>2023–2025</span></div><div class="cv-entry"><div><h3>Yonsei University</h3><p>B.S. in Creative Technology Management<br />Underwood International College</p></div><span>2019–2023</span></div></div></section>
    <section class="cv-section"><h2>Research experience</h2><div><div class="cv-entry"><div><h3>Human Artificial Intelligence Research Lab</h3><p>Yonsei University · Advisor: Professor Keeheon Lee</p></div><span>2021–present</span></div><ul class="cv-roles"><li><span>Researcher</span><span>Sep. 2025–present</span></li><li><span>Graduate Researcher</span><span>Sep. 2023–Aug. 2025</span></li><li><span>Undergraduate Research Assistant</span><span>Mar. 2021–Aug. 2023</span></li></ul></div></section>
    <section class="cv-section"><h2>Publications</h2><div class="cv-publications">{papers.filter(p=>!p.workshop && p.status!=='Workshop').map(p=><div class="cv-publication"><h3><a href={`/research/${p.slug}/`}>{p.title}</a></h3><p><Authors authors={p.authors}/></p><p class="muted">{p.venue}{p.status==='Accepted' && ' · Accepted'}</p>{p.doi && <a class="cv-doi" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>}</div>)}</div></section>
    <section class="cv-section"><h2>Workshop papers</h2><div class="cv-publications">{papers.filter(p=>p.workshop || p.status==='Workshop').map(p=><div class="cv-publication"><h3><a href={`/research/${p.slug}/`}>{p.title}</a></h3><p><Authors authors={p.authors}/></p><p class="muted">{p.venue}{p.status==='Accepted' && ' · Accepted'}{p.presentation && ` · ${p.presentation}`}{p.slug==='moral-profile-dynamics' && ' · Non-archival poster paper'}</p></div>)}</div></section>
    <section class="cv-section">
      <h2>Awards & funding</h2>
      <div>
        <div class="cv-entry"><div><h3>Master’s Student Research Encouragement Grant</h3><p>National Research Foundation of Korea</p></div><span>2024–2025</span></div>
        <div class="cv-entry"><div><h3>Full-Tuition Scholarship</h3><p>Integrated B.S.–M.S. Program · Yonsei University</p></div><span>4 semesters</span></div>
        <div class="cv-entry"><div><h3>Academic Excellence Scholarship</h3><p>Yonsei University</p></div><span>2020</span></div>
      </div>
    </section>
    <section class="cv-section">
      <h2>Teaching</h2>
      <div>
        <p class="cv-group-label">Teaching Assistant · Yonsei University</p>
        <ul class="cv-compact-list">
          {[
            ['Techno-Art Capstone Project', 'Spring 2025'],
            ['Data Science for Business', 'Spring 2025'],
            ['Social Network Analysis', 'Fall 2024'],
            ['Python for Data Analysis & Text Analysis (CDSS)', 'Jan. 2023'],
          ].map(([course, date]) => <li><span>{course}</span><span class="cv-date">{date}</span></li>)}
        </ul>
      </div>
    </section>
    <section class="cv-section">
      <h2>Service & leadership</h2>
      <ul class="cv-compact-list">
        <li><span>Manager, HAIR Lab</span><span class="cv-date">Sep. 2025–present</span></li>
        <li><span>President, DATUM — Yonsei UIC Data Science Academia</span><span class="cv-date">Sep. 2021–Aug. 2022</span></li>
      </ul>
    </section>
  </article>
  <script>document.querySelector('#print-cv')?.addEventListener('click',()=>window.print());</script>
</Layout>
