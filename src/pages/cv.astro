---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { papers } from '../data/papers';
---
<Layout title="Curriculum vitae" description="Kunhee Ryu’s curriculum vitae: education, research, publications, teaching, and academic service.">
  <article class="cv wrap">
    <header class="cv-head"><div><span class="eyebrow">Curriculum vitae</span><h1>Kunhee Ryu</h1><p>Researcher · Human Artificial Intelligence Research Lab<br />Yonsei University · Seoul, Republic of Korea</p><a href={`mailto:${profile.email}`}>{profile.email}</a><div class="cv-socials"><a href={profile.links.scholar}>Google Scholar ↗</a><a href={profile.links.orcid}>ORCID ↗</a><a href={profile.links.github}>GitHub ↗</a></div></div><div class="cv-actions"><a class="button button-dark" href="/Kunhee_Ryu_CV.pdf" download>Download CV <span aria-hidden="true">↓</span></a><button class="button" id="print-cv">Print CV ↗</button><span class="eyebrow">Updated September 2026</span></div></header>
    <section class="cv-section"><h2>Research interests</h2><div><p>Representation learning; sequential decision-making and planning; multi-agent systems; human–AI interaction.</p></div></section>
    <section class="cv-section"><h2>Education</h2><div><div class="cv-entry"><div><h3>Yonsei University</h3><p>M.S. in Innovation</p><p class="muted">Advisor: Professor Keeheon Lee</p><p class="cv-small">Thesis: Enhancing Document Retrieval-Augmented Generation through Knowledge Graph Integration for Biomedical Question Answering</p></div><span>2023–2025</span></div><div class="cv-entry"><div><h3>Yonsei University</h3><p>B.S. in Creative Technology Management<br />Underwood International College</p></div><span>2019–2023</span></div></div></section>
    <section class="cv-section"><h2>Research experience</h2><div><div class="cv-entry"><div><h3>Human Artificial Intelligence Research Lab</h3><p>Yonsei University · Advisor: Professor Keeheon Lee</p></div><span>2021–present</span></div><ul class="cv-roles"><li><span>Researcher</span><span>Sep. 2025–present</span></li><li><span>Graduate Researcher</span><span>Sep. 2023–Aug. 2025</span></li><li><span>Undergraduate Research Assistant</span><span>Mar. 2021–Aug. 2023</span></li></ul><p>Research on LLM agents, sequential decision-making, multi-agent coordination, human–AI interaction, information retrieval, and reliable evaluation.</p></div></section>
    <section class="cv-section"><h2>Publications</h2><div class="cv-publications">{papers.filter(p=>p.status!=='Workshop').map(p=><div class="cv-publication"><h3><a href={`/research/${p.slug}/`}>{p.title}</a></h3><p>{p.authors}</p><p class="muted">{p.venue} · {p.year}{p.status==='Accepted' && ' · Accepted'}</p>{p.doi && <a class="cv-doi" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>}</div>)}</div></section>
    <section class="cv-section"><h2>Workshop papers</h2><div class="cv-publications">{papers.filter(p=>p.status==='Workshop').map(p=><div class="cv-publication"><h3><a href={`/research/${p.slug}/`}>{p.title}</a></h3><p>{p.authors}</p><p class="muted">{p.venue} · {p.year}{p.slug==='moral-profile-dynamics' && ' · Non-archival poster paper'}</p></div>)}</div></section>
    <section class="cv-section"><h2>Selected funding</h2><div><div class="cv-entry"><div><h3>Master’s Student Research Encouragement Grant</h3><p>National Research Foundation of Korea</p><p class="muted">Grant recipient and proposal author</p></div><span>2024–2025</span></div></div></section>
    <section class="cv-section"><h2>Teaching</h2><div>{[['Techno-Art Capstone Project','Yonsei University','Spring 2025'],['Data Science for Business','Yonsei University','Spring 2025'],['Social Network Analysis','Yonsei University','Fall 2024'],['Python for Data Analysis & Text Analysis','Yonsei CDSS','Jan. 2023']].map(([course,school,date])=><div class="cv-entry"><div><h3>{course}</h3><p>Teaching Assistant · {school}</p></div><span>{date}</span></div>)}</div></section>
    <section class="cv-section"><h2>Service & leadership</h2><div>{[['Manager, HAIR Lab','Sep. 2025–present'],['Associate, HAIR Lab','Sep. 2023–Sep. 2025'],['Student Representative, Department of Innovation','Mar.–Dec. 2024'],['Faculty Assistant, Department of Innovation','Mar.–Aug. 2024'],['President, DATUM — Yonsei UIC Data Science Academia','Sep. 2021–Aug. 2022']].map(([role,date])=><div class="cv-entry"><h3>{role}</h3><span>{date}</span></div>)}</div></section>
    <section class="cv-section"><h2>Selected awards</h2><div>{[['Grand Prize, RISE Tourism Development Hackathon','2025'],['Full-Tuition Scholarship, Integrated B.S.–M.S. Program','4 semesters'],['Excellence Award, 10th Chung Ju-yung Startup Competition','2021'],['Academic Excellence Scholarship, Yonsei University','2020']].map(([award,date])=><div class="cv-entry"><h3>{award}</h3><span>{date}</span></div>)}</div></section>
    <section class="cv-section"><h2>Methods & tools</h2><div><p><strong>Systems.</strong> Retrieval-augmented generation, graph-based retrieval, multi-agent workflows.</p><p><strong>Evaluation.</strong> Checkpoint selection, token likelihood, controlled ablations, hierarchical bootstrapping, sensitivity analysis.</p><p><strong>Human–AI research.</strong> Controlled user studies, semi-structured interviews, qualitative coding, thematic analysis, interaction logs.</p><p><strong>Programming.</strong> Python, R, SQL, PyTorch, Hugging Face Transformers, scikit-learn, LaTeX.</p></div></section>
  </article>
  <script>document.querySelector('#print-cv')?.addEventListener('click',()=>window.print());</script>
</Layout>
