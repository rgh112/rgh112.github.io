---
import Layout from '../../layouts/Layout.astro';
import PaperCard from '../../components/PaperCard.astro';
import { papers } from '../../data/papers';
const categories = ['All research', 'Agents & planning', 'Learning & evaluation', 'Multi-agent systems', 'Human–AI interaction', 'Information extraction'];
---
<Layout title="Research" description="Research by Kunhee Ryu on scientific exploration with LLM agents, generalization, multi-agent evidence synthesis, and human–AI interaction.">
  <section class="page-head wrap"><span class="eyebrow">Research / 2022—2026</span><h1>Following the<br /><em>questions.</em></h1><p>How do we learn from evidence, reason beyond familiar patterns, and choose an action whose consequences we understand?</p></section>
  <section class="research-catalog wrap" aria-label="Research catalog">
    <div class="catalog-tools"><div class="filter-buttons" role="group" aria-label="Filter by research topic">{categories.map((category,index)=><button class="filter-button" data-filter={category} aria-pressed={index===0}>{category}</button>)}</div><label class="search-label"><span class="sr-only">Search research</span><input type="search" id="research-search" placeholder="Search research…" /><span aria-hidden="true">⌕</span></label></div>
    <div class="catalog-count"><span class="eyebrow" id="result-count" aria-live="polite">{papers.length} research stories</span><span>Published work & accepted papers</span></div>
    <div class="paper-grid" id="research-results">{papers.map((paper,index)=><PaperCard paper={paper} index={index}/>)}</div>
    <div class="empty-state" hidden><h2>No matching research.</h2><p>Try a broader term or a different topic.</p><button class="text-link" id="clear-filters">Clear filters <span aria-hidden="true">↗</span></button></div>
  </section>
  <section class="directions-link wrap"><span class="eyebrow">The next questions</span><h2>Where this work<br /><em>is taking me.</em></h2><a class="text-link" href="/directions/">Research directions <span aria-hidden="true">↗</span></a></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#research-search')!;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('#research-results .paper-card');
    let selected = 'All research';
    function update() {
      let count = 0;
      for (const card of cards) { const show = (selected === 'All research' || card.dataset.category === selected) && card.dataset.search!.includes(input.value.trim().toLowerCase()); card.hidden = !show; if(show)count++; }
      document.querySelector('#result-count')!.textContent = `${count} research ${count === 1 ? 'story' : 'stories'}`;
      (document.querySelector('.empty-state') as HTMLElement).hidden = count !== 0;
      buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===selected)));
    }
    buttons.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.filter!;update();}));
    input.addEventListener('input',update);
    document.querySelector('#clear-filters')!.addEventListener('click',()=>{selected='All research';input.value='';update();input.focus();});
  </script>
</Layout>
