---
import Layout from '../../layouts/Layout.astro';
import Diagram from '../../components/Diagram.astro';
import WuxiaPractice from '../../components/WuxiaPractice.astro';
import PaperFigure from '../../components/PaperFigure.astro';
import { paperFigures } from '../../data/paper-figures';
import { papers } from '../../data/papers';
export function getStaticPaths() { return papers.map(paper=>({params:{slug:paper.slug},props:{paper}})); }
const { paper } = Astro.props;
const sourceFigure = paperFigures[paper.slug];
const next = papers[(papers.findIndex(p=>p.slug===paper.slug)+1)%papers.length];
---
<Layout title={paper.short} description={paper.summary}>
  <article class="paper-detail wrap">
    <a class="back-link" href="/research/">← All research</a>
    <header class="detail-head"><div class="paper-meta"><span>{paper.venue}</span><span class="status">{paper.status}</span></div><h1>{paper.question}</h1><p class="detail-summary">{paper.summary}</p><div class="detail-byline"><span>{paper.role}</span><span>{paper.category}</span></div></header>
    <div class="detail-grid"><aside class="detail-sidebar"><span class="eyebrow">In this research</span><nav aria-label="On this page">{paper.origin && <a href="#origin">The starting point</a>}<a href="#approach">The approach</a><a href="#finding">What we found</a><a href="#scope">Scope & limitations</a><a href="#next">The next question</a><a href="#publication">Publication</a></nav></aside>
      <div class="detail-body">
        <figure class="detail-figure"><Diagram kind={paper.diagram} interactive /></figure>
        {paper.origin && <section id="origin" class:list={['origin-note', {'origin-wuxia':paper.slug==='ood-resolution'}]}><div class="origin-copy"><span class="eyebrow">{paper.originLabel}</span><p>{paper.origin}</p><span class="origin-signature">— Kunhee</span></div>{paper.slug==='ood-resolution' && <WuxiaPractice />}</section>}
        <section id="approach" class="prose-section"><span class="eyebrow">01 / The approach</span><h2>{paper.slug==='beyond-local-validity' ? 'Scientific exploration, one edit at a time.' : paper.slug==='ood-resolution' ? 'Make the invisible choice visible.' : 'Turn the question into an experiment.'}</h2><p>{paper.method}</p></section>
        {sourceFigure?.placement==='approach' && <PaperFigure figure={sourceFigure} />}
        <section id="finding" class="prose-section"><span class="eyebrow">02 / What we found</span><h2>{paper.slug==='beyond-local-validity' ? 'An edit changes the space of possibilities.' : paper.slug==='ood-resolution' ? 'A tied score leaves a decision unresolved.' : paper.slug==='autometa' ? 'Verification changes the synthesis.' : paper.slug==='clinician-trust' ? 'Evidence invites another look.' : 'Look at the interaction.'}</h2><p>{paper.finding}</p></section>
        {sourceFigure?.placement==='finding' && <PaperFigure figure={sourceFigure} />}
        <section id="scope" class="scope-note"><span class="eyebrow">Scope & limitations</span><p>{paper.limitation}</p></section>
        <section id="next" class="next-question"><span class="eyebrow">The question this opens</span><h2>{paper.next}</h2><a href="/directions/" class="text-link">Connect to my research directions <span aria-hidden="true">↗</span></a></section>
        <section id="publication" class="publication-box"><span class="eyebrow">Publication details</span><h2>{paper.title}</h2><p>{paper.authors}</p><p>{paper.venue} · {paper.year} · {paper.status}</p><div class="publication-links">{paper.doi && <a class="button" href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer">Read the paper ↗</a>}{paper.external && <a class="button" href={paper.external} target="_blank" rel="noopener noreferrer">Workshop paper ↗</a>}{paper.code && <a class="button" href={paper.code} target="_blank" rel="noopener noreferrer">Code & materials ↗</a>}<button class="button copy-citation" data-citation={paper.citation}>Copy citation</button></div><p class="copy-status sr-only" aria-live="polite"></p><details><summary>BibTeX citation</summary><pre>{paper.citation}</pre></details></section>
      </div>
    </div>
  </article>
  <section class="next-paper wrap"><span class="eyebrow">Keep exploring</span><a href={`/research/${next.slug}/`}>{next.short}<span aria-hidden="true">↗</span></a></section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-citation').forEach(button=>button.addEventListener('click',async()=>{
      const status = document.querySelector('.copy-status')!;
      try { await navigator.clipboard.writeText(button.dataset.citation!); button.textContent='Copied ✓'; status.textContent='Citation copied to clipboard.';setTimeout(()=>button.textContent='Copy citation',2200); }
      catch { const details=document.querySelector<HTMLDetailsElement>('.publication-box details')!;details.open=true;status.textContent='Copy the citation from the expanded BibTeX section.';details.scrollIntoView({block:'nearest'}); }
    }));
  </script>
</Layout>
